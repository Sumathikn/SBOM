# ══════════════════════════════════════════════════════════════════════════════
# SBOMGuard Production & Local Configuration
# Copy this file to .env and customize for your environment.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ─── CORS & Security ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# In development, localhost origins are allowed by default.
# In production, set this to your actual frontend domain(s).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173

# ─── PostgreSQL Database (Production Engine) ─────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sbomguard

# Async SQLAlchemy connection string (used by FastAPI runtime)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sbomguard

# Sync SQLAlchemy connection string (used by Alembic migrations)
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sbomguard

# Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Multi-Tenancy & Project Isolation
DEFAULT_TENANT_ID=default

# ─── Redis Caching ───────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=86400

# ─── Security Intelligence Feeds & API Keys ──────────────────────────────────
# NVD API Key: Request free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# GitHub Personal Access Token for Advisory Database enrichment
GITHUB_TOKEN=
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_BASE=https://api.first.org/data/v1/epss

# ─── DevSecOps CI/CD Policy Gates ───────────────────────────────────────────
FAIL_ON_SEVERITY=high
FAIL_ON_CVSS=7.0
FAIL_ON_KEV=true
SARIF_OUTPUT_FILE=sbomguard-results.sarif

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_RPM=240
RATE_LIMIT_BURST=60

# ─── Upload & Processing Limits ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
MAX_COMPONENTS_PER_SBOM=5000
